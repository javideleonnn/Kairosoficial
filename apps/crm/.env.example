# Copiar a .env.local y completar con los valores reales del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — nunca prefijar con NEXT_PUBLIC_. Se usa para operaciones
# administrativas (ej. invitar asesores) que deben bypassear RLS a propósito.
SUPABASE_SERVICE_ROLE_KEY=
