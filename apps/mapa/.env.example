# Copiar a .env.local y completar con los valores reales del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — nunca prefijar con NEXT_PUBLIC_. El Route Handler de
# /api/diagnostic/submit la usa para guardar el diagnóstico bypasseando RLS
# a propósito (el usuario que completa Mapa Kairos nunca está autenticado).
SUPABASE_SERVICE_ROLE_KEY=

# El primer diagnóstico funcional es de una sola organización (la tuya) —
# no hay todavía selector de organización ni multi-tenant real en Mapa
# Kairos. Se resuelve el día que haga falta (ver Módulo 8, decisión 1).
KAIROS_ORGANIZATION_ID=

# Número de WhatsApp para el CTA de "Solicitar revisión personalizada"
# (formato internacional sin +, ej. 50212345678). El Módulo 10 (ManyChat)
# añade el contacto proactivo automático; esto es el CTA reactivo iniciado
# por el usuario, funciona sin depender de ese módulo.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ManyChat — Módulo 10. Se generan en Settings → API de tu cuenta ManyChat.
MANYCHAT_API_TOKEN=
# El flow_ns de la automatización que se dispara al completar el diagnóstico
# (se encuentra en la URL del flow builder de ManyChat).
MANYCHAT_FLOW_NS=
# IDs de custom fields creados en tu cuenta ManyChat (Settings → Fields),
# opcionales — si no se configuran, simplemente no se setean esos campos
# antes de disparar el flow.
MANYCHAT_FIELD_ID_RESULT_CODE=
MANYCHAT_FIELD_ID_DOMINANT_BLOCK=
# Secreto compartido para validar el webhook entrante de ManyChat
# (?secret=... en la URL configurada como "External Request" en ManyChat).
MANYCHAT_WEBHOOK_SECRET=
